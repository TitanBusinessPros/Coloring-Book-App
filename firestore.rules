rules_version = '2';

// Default-deny. No Firestore data is in use yet — this app currently only
// needs Firebase Authentication (Google sign-in). Tighten/expand these
// rules deliberately when real data collections are added.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
